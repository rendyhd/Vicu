{
  "name": "vicu",
  "version": "1.8.0",
  "description": "A task management app powered by Vikunja",
  "main": "./out/main/index.js",
  "desktopName": "com.rendyhd.vicu",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/clean-out.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:publish": "npm run build && electron-builder --mac --publish always",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:publish": "npm run build && electron-builder --linux --publish always",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json --pretty false && tsc --noEmit --composite false -p tsconfig.web.json --pretty false && tsc --noEmit --composite false -p tsconfig.vite.json --pretty false",
    "verify": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "rendyhd",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.6",
    "@tanstack/react-query": "^5.50.0",
    "@tanstack/react-router": "^1.45.0",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "chrono-node": "^2.7.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.4.16",
    "koffi": "^2.15.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  }
}
