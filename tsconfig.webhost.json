{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "outDir": "./out",
    "rootDir": ".",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@host/*": ["./src/web/host/*"]
    }
  },
  "include": [
    "test-fixtures/ai-tools-v1.json",
    "src/web/**/*"
  ],
  "exclude": ["src/web/**/__tests__/**"]
}
