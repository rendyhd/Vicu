  "type": {
    "about": "Type scale. Desktop sizes are px with weight and an optional line height in px; Android gives the M3 style and its sp size where the contract fixes one. Nothing is below 11.",
    "pageTitle": { "px": 26, "weight": 700, "android": { "style": "large top app bar", "sp": 28, "bold": true } },
    "section": { "px": 13, "weight": 600, "note": "with a count", "android": { "style": "titleSmall" } },
    "group": { "px": 12, "weight": 600, "note": "with a dot", "android": { "style": "labelMedium" } },
    "taskTitle": { "px": 14, "weight": 400, "lineHeightPx": 20, "android": { "style": "bodyLarge", "sp": 16 } },
    "cardTitle": { "px": 15, "weight": 600 },
    "meta": { "px": 12, "weight": 500, "android": { "style": "labelMedium", "sp": 12 } },
