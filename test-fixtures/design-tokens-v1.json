{
  "contractVersion": 1,
  "about": "Design token contract for docs/design-system-v1.md. Colours are #RRGGBB, sizes are px on desktop and dp or sp on Android, times are milliseconds. Role names are dotted. Keep this file identical in vicu and vicu-android.",
  "roles": {
    "bg.page": { "light": "#FFFFFF", "dark": "#1C1C1E", "note": "page background" },
    "bg.sidebar": { "light": "#F5F5F7", "dark": "#2C2C2E", "note": "sidebar; macOS keeps its translucent override" },
    "bg.card": { "light": "#FFFFFF", "dark": "#2A2A2D", "note": "cards and popovers; dark adds a 1 px highlight, #FFFFFF at 8%, and no shadow" },
    "bg.hover": { "light": "#F2F2F7", "dark": "#323234", "note": "hover fill" },
    "bg.selected": { "light": "#E8F0FE", "dark": "#1C3049", "note": "selected row and item fill" },
    "border": { "light": "#E5E5EA", "dark": "#38383A", "note": "separators only, never a control boundary" },
    "text": { "light": "#1D1D1F", "dark": "#F5F5F7", "note": "primary text" },
    "text.secondary": { "light": "#636366", "dark": "#AEAEB2", "note": "secondary text and placeholders" },
    "text.tertiary": { "light": "#AEAEB2", "dark": "#636366", "note": "disabled and decoration only, never readable text" },
    "control.ring": { "light": "#8E8E93", "dark": "#7C7C80", "note": "checkbox and radio rings" },
    "accent": { "light": "#0A66D1", "dark": "#6AACFF", "note": "links and accent text" },
    "accent.fill": { "light": "#0A66D1", "dark": "#0A66D1", "note": "filled buttons and the checked checkbox" },
    "on.accent": { "light": "#FFFFFF", "dark": "#FFFFFF", "note": "content on accent.fill" },
    "focus.ring": { "light": "#0A66D1", "dark": "#6AACFF", "note": "keyboard focus ring" },
    "status.overdue": { "light": "#D70015", "dark": "#FF7B73", "note": "overdue dates and marks" },
    "status.today": { "light": "#C2410C", "dark": "#FFB340", "note": "due today" },
    "status.done": { "light": "#1E7D34", "dark": "#30D158", "note": "completed" },
    "danger": { "light": "#D70015", "dark": "#FF7B73", "note": "delete, clear date" },
    "priority.low": { "light": "#0066CC", "dark": "#6AACFF", "note": "priority 1" },
    "priority.medium": { "light": "#8A5F00", "dark": "#FFD60A", "note": "priority 2" },
    "priority.high": { "light": "#A74A09", "dark": "#FF9F0A", "note": "priority 3" },
    "priority.urgent": { "light": "#D70015", "dark": "#FF7B73", "note": "priority 4 and 5" },
    "palette.red": { "light": "#FF3B30", "dark": "#FF453A", "note": "icons only" },
    "palette.orange": { "light": "#FF9500", "dark": "#FF9F0A", "note": "icons only" },
    "palette.yellow": { "light": "#FFCC00", "dark": "#FFD60A", "note": "icons only" },
    "palette.green": { "light": "#34C759", "dark": "#30D158", "note": "icons only" },
    "palette.purple": { "light": "#AF52DE", "dark": "#BF5AF2", "note": "icons only" },
    "palette.teal": { "light": "#5AC8FA", "dark": "#64D2FF", "note": "icons only" }
  },
  "css": {
    "about": "Desktop CSS variable of a role: two dashes plus the role with dots turned into dashes, unless listed in aliases (legacy names kept so existing CSS keeps working). bg.sidebar keeps its raw var() form: it has a translucent override on macOS and never gets a channel variable or an opacity class.",
    "aliases": {
      "bg.page": "--bg-primary",
      "text": "--text-primary",
      "accent": "--accent-blue",
      "border": "--border-color",
      "palette.red": "--accent-red",
      "palette.orange": "--accent-orange",
      "palette.yellow": "--accent-yellow",
      "palette.green": "--accent-green",
      "palette.purple": "--accent-purple",
      "palette.teal": "--accent-teal"
    },
    "rawVar": ["bg.sidebar"]
  },
  "contrast": {
    "about": "Pairs to assert in both themes. A background is a role name or a tint: the role at alpha composited over another role, channels rounded half up to 8 bits. Ratio is WCAG 2.x relative luminance (sRGB linearisation threshold 0.04045).",
    "rules": [
      { "name": "text on surfaces", "fg": "text", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "text.secondary on surfaces", "fg": "text.secondary", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 5.2 },
      { "name": "accent on surfaces", "fg": "accent", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "status.overdue on surfaces", "fg": "status.overdue", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "status.today on surfaces", "fg": "status.today", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "status.done on surfaces", "fg": "status.done", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "danger on surfaces", "fg": "danger", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "priority.low on surfaces", "fg": "priority.low", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "priority.medium on surfaces", "fg": "priority.medium", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "priority.high on surfaces", "fg": "priority.high", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "priority.urgent on surfaces", "fg": "priority.urgent", "bg": ["bg.page", "bg.sidebar", "bg.card", "bg.hover", "bg.selected"], "min": 4.5 },
      { "name": "on.accent on accent.fill", "fg": "on.accent", "bg": ["accent.fill"], "min": 4.5 },
      { "name": "control.ring on page and card", "fg": "control.ring", "bg": ["bg.page", "bg.card"], "min": 3 },
      { "name": "focus.ring on page and card", "fg": "focus.ring", "bg": ["bg.page", "bg.card"], "min": 3 },
      {
        "name": "status.overdue on its own 8% tint over bg.page",
        "fg": "status.overdue",
        "bg": [{ "tint": "status.overdue", "alpha": 0.08, "over": "bg.page" }],
        "min": 4.5
      }
    ]
  },
  "labelChip": {
    "about": "Label chips: the label colour at tintAlpha over bg.page is the fill; the text is the label colour kept in hue and saturation (HSL) and moved in lightness until it passes minContrast on that fill.",
    "tintAlpha": 0.12,
    "text": { "sizePx": 11, "weight": 600 },
    "minContrast": 4.5,
    "derivation": [
      "tint = round(alpha * label + (1 - alpha) * bg.page) per channel, rounded half up, with the bg.page of the theme.",
      "Convert the label to HSL (h in degrees, s and l as fractions, no rounding).",
      "For n = 0, 1, 2 ...: lightness = clamp(l - n / 100) in light mode, clamp(l + n / 100) in dark mode, with the same h and s; n = 0 is the label itself.",
      "Convert each candidate to sRGB with the standard HSL formulas and round each channel to 8 bits as floor(channel * 255 + 0.5 + 1e-9) (once per candidate, never between steps; the 1e-9 makes exact ties round up the same way on every platform).",
      "The first candidate whose contrast against tint is at least minContrast is the text colour."
    ],
    "vectors": [
      { "label": "#1973FF", "source": "vikunja.picker", "light": { "text": "#0060F4", "tint": "#E3EEFF" }, "dark": { "text": "#428CFF", "tint": "#1C2639" } },
      { "label": "#7F23FF", "source": "vikunja.picker", "light": { "text": "#7F23FF", "tint": "#F0E5FF" }, "dark": { "text": "#A96AFF", "tint": "#281D39" } },
      { "label": "#FF4136", "source": "vikunja.picker", "light": { "text": "#D40C00", "tint": "#FFE8E7" }, "dark": { "text": "#FF4B40", "tint": "#372021" } },
      { "label": "#FF851B", "source": "vikunja.picker", "light": { "text": "#AF5100", "tint": "#FFF0E4" }, "dark": { "text": "#FF851B", "tint": "#37291E" } },
      { "label": "#FFEB10", "source": "vikunja.picker", "light": { "text": "#807500", "tint": "#FFFDE2" }, "dark": { "text": "#FFEB10", "tint": "#37351C" } },
      { "label": "#00DB60", "source": "vikunja.picker", "light": { "text": "#007F38", "tint": "#E0FBEC" }, "dark": { "text": "#00DB60", "tint": "#193326" } },
      { "label": "#FFBE0B", "source": "vikunja.newLabel", "light": { "text": "#906900", "tint": "#FFF7E2" }, "dark": { "text": "#FFBE0B", "tint": "#372F1C" } },
      { "label": "#FD8A09", "source": "vikunja.newLabel", "light": { "text": "#A95A01", "tint": "#FFF1E1" }, "dark": { "text": "#FD8A09", "tint": "#37291B" } },
      { "label": "#FB5607", "source": "vikunja.newLabel", "light": { "text": "#BD3F03", "tint": "#FFEBE1" }, "dark": { "text": "#FB5607", "tint": "#37231B" } },
      { "label": "#FF006E", "source": "vikunja.newLabel", "light": { "text": "#CC0058", "tint": "#FFE0EE" }, "dark": { "text": "#FF2E88", "tint": "#371928" } },
      { "label": "#EFBDEB", "source": "vikunja.newLabel", "light": { "text": "#C12FB5", "tint": "#FDF7FD" }, "dark": { "text": "#EFBDEB", "tint": "#352F37" } },
      { "label": "#8338EC", "source": "vikunja.newLabel", "light": { "text": "#8338EC", "tint": "#F0E7FD" }, "dark": { "text": "#A670F1", "tint": "#281F37" } },
      { "label": "#5F5FF6", "source": "vikunja.newLabel", "light": { "text": "#5151F5", "tint": "#ECECFE" }, "dark": { "text": "#8181F8", "tint": "#242438" } },
      { "label": "#3A86FF", "source": "vikunja.newLabel", "light": { "text": "#005FF7", "tint": "#E7F0FF" }, "dark": { "text": "#498FFF", "tint": "#202939" } },
      { "label": "#4C91FF", "source": "vikunja.newLabel", "light": { "text": "#0060F9", "tint": "#EAF2FF" }, "dark": { "text": "#4C91FF", "tint": "#222A39" } },
      { "label": "#0EAD69", "source": "vikunja.newLabel", "light": { "text": "#0A7E4C", "tint": "#E2F5ED" }, "dark": { "text": "#0EAD69", "tint": "#1A2D27" } },
      { "label": "#25BE8B", "source": "vikunja.newLabel", "light": { "text": "#197E5C", "tint": "#E5F7F1" }, "dark": { "text": "#25BE8B", "tint": "#1D2F2B" } },
      { "label": "#073B4C", "source": "vikunja.newLabel", "light": { "text": "#073B4C", "tint": "#E1E7EA" }, "dark": { "text": "#1192BC", "tint": "#192024" } },
      { "label": "#373F47", "source": "vikunja.newLabel", "light": { "text": "#373F47", "tint": "#E7E8E9" }, "dark": { "text": "#7A8998", "tint": "#1F2023" } },
      { "label": "#5AC8FA", "source": "review", "light": { "text": "#0578AC", "tint": "#EBF8FE" }, "dark": { "text": "#5AC8FA", "tint": "#233138" } },
      { "label": "#000000", "source": "edge", "light": { "text": "#000000", "tint": "#E0E0E0" }, "dark": { "text": "#828282", "tint": "#19191A" } },
      { "label": "#808080", "source": "edge", "light": { "text": "#6C6C6C", "tint": "#F0F0F0" }, "dark": { "text": "#8F8F8F", "tint": "#28282A" } },
      { "label": "#FFFFFF", "source": "edge", "light": { "text": "#757575", "tint": "#FFFFFF" }, "dark": { "text": "#FFFFFF", "tint": "#373739" } }
    ]
  },
  "priority": {
    "about": "Vikunja priority to mark and colour role. 0 shows nothing. A mark never carries meaning alone: it has a text name for assistive technology.",
    "levels": {
      "1": { "mark": "bars-1", "role": "priority.low" },
      "2": { "mark": "bars-2", "role": "priority.medium" },
      "3": { "mark": "bars-3", "role": "priority.high" },
      "4": { "mark": "square-bang", "role": "priority.urgent" },
      "5": { "mark": "square-bang", "role": "priority.urgent" }
    }
  },
  "identity": {
    "about": "Smart list identity. These colours only ever colour list icons, never text.",
    "lists": {
