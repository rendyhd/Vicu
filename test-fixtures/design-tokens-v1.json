  "radius": {
    "about": "Corner radii. Desktop px, Android dp; null means the platform has no such surface.",
    "control": { "px": 6, "dp": 8 },
    "popover": { "px": 10, "dp": 12 },
    "card": { "px": 12, "dp": 12 },
    "sheet": { "px": null, "dp": 28 },
    "chip": "full"
  },
  "motion": {
    "about": "Durations in ms. A spring is a damping ratio and a stiffness (Compose spring(dampingRatio, stiffness)); desktop turns a spring into a CSS duration plus a generated curve. Every motion has a reduced variant (docs/design-system-v1.md).",
    "fade": {
      "fast": { "ms": 150, "easing": "cubic-bezier(0.2, 0, 0, 1)", "spring": { "damping": 1, "stiffness": 3800 } },
      "base": { "ms": 240, "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)", "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)", "spring": { "damping": 1, "stiffness": 1600 } }
    },
    "move": { "ms": 320, "spring": { "damping": 0.9, "stiffness": 700 } },
    "moveExpressive": { "ms": 440, "spring": { "damping": 0.8, "stiffness": 380 } },
    "pop": { "ms": 360, "spring": { "damping": 0.6, "stiffness": 800 } },
    "page": { "outMs": 90, "inMs": 210, "risePx": 6 },
    "stagger": { "ms": 35, "maxItems": 5 },
    "keyboardMoveMaxMs": 120,
    "checkDrawMs": 220,
    "strikeDrawMs": 240,
    "motionScheme": {
      "fastSpatial": { "damping": 0.6, "stiffness": 800 },
      "defaultSpatial": { "damping": 0.9, "stiffness": 700 },
      "slowSpatial": { "damping": 0.9, "stiffness": 300 },
      "fastEffects": { "damping": 1, "stiffness": 3800 },
      "defaultEffects": { "damping": 1, "stiffness": 1600 },
      "slowEffects": { "damping": 1, "stiffness": 800 }
    }
  },
