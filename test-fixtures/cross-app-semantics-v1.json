    { "name": "this_week on a Sunday with overdue", "today": "2026-10-11", "filter": { "due_date_filter": "this_week" }, "expect": [1, 2, 3, 4, 5, 6, 12, 13] },
    { "name": "this_week on a Sunday without overdue", "today": "2026-10-11", "filter": { "due_date_filter": "this_week", "include_overdue": false }, "expect": [6] },
    { "name": "this_week on a Monday without overdue", "today": "2026-10-12", "filter": { "due_date_filter": "this_week", "include_overdue": false }, "expect": [7] },
    { "name": "this_month near month end without overdue", "today": "2026-10-30", "filter": { "due_date_filter": "this_month", "include_overdue": false }, "expect": [8] },
    { "name": "this_month on the first without overdue", "today": "2026-11-01", "filter": { "due_date_filter": "this_month", "include_overdue": false }, "expect": [9] }
