    { "name": "excluded", "today": "2026-10-06", "defaultCadence": 14, "meta": { "state": "excluded", "lastReviewedAt": "2026-01-01" }, "expect": { "isOverdue": false, "daysSince": null, "daysUntil": null, "next": null } },
    { "name": "reviewed today", "today": "2026-10-06", "defaultCadence": 14, "meta": { "state": "reviewed", "lastReviewedAt": "2026-10-06" }, "expect": { "isOverdue": false, "daysSince": 0, "daysUntil": 14, "next": "2026-10-20" } },
    { "name": "due today", "today": "2026-10-06", "defaultCadence": 14, "meta": { "state": "reviewed", "lastReviewedAt": "2026-09-22" }, "expect": { "isOverdue": false, "daysSince": 14, "daysUntil": 0, "next": "2026-10-06" } },
    { "name": "one day overdue", "today": "2026-10-06", "defaultCadence": 14, "meta": { "state": "reviewed", "lastReviewedAt": "2026-09-21" }, "expect": { "isOverdue": true, "daysSince": 15, "daysUntil": -1, "next": "2026-10-05" } },
