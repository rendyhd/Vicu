    { "name": "across the EU DST change", "today": "2026-11-03", "defaultCadence": 14, "meta": { "state": "reviewed", "lastReviewedAt": "2026-10-20" }, "expect": { "isOverdue": false, "daysSince": 14, "daysUntil": 0, "next": "2026-11-03" } },
    { "name": "across the year end", "today": "2027-01-08", "defaultCadence": 14, "meta": { "state": "reviewed", "lastReviewedAt": "2026-12-25" }, "expect": { "isOverdue": false, "daysSince": 14, "daysUntil": 0, "next": "2027-01-08" } }
